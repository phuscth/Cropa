{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "test": {
      "outputs": []
    },
    "@cropa/core#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/presets/**"],
      "outputs": []
    }
  }
}
