{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window (editor, history and settings views): listens to app events, reads the app version and the shortcut status, reads and changes user settings, lists, copies, opens and deletes past captures, manages the user's saved background presets and background images and exports a preset to a file, saves, copies and reveals exported images, lets the user drag the image into other apps, and detects, sets up, runs and cancels AI turns.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "allow-get-main-view",
    "allow-get-settings",
    "allow-get-shortcut-status",
    "allow-set-capture-shortcut",
    "allow-open-print-screen-setting",
    "allow-set-theme",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-set-save-history",
    "allow-set-exclude-from-clipboard-history",
    "allow-choose-save-folder",
    "allow-reset-save-folder",
    "allow-open-sponsors-page",
    "allow-list-history",
    "allow-get-history-thumbnail",
    "allow-copy-history-image",
    "allow-delete-history-image",
    "allow-delete-all-history",
    "allow-open-history-in-editor",
    "allow-get-editor-image",
    "allow-quick-save",
    "allow-choose-save-as-path",
    "allow-write-save-as",
    "allow-copy-rendered-image",
    "allow-start-drag",
    "allow-reveal-saved-file",
    "allow-list-user-presets",
    "allow-save-user-preset",
    "allow-delete-user-preset",
    "allow-save-preset-file",
    "allow-list-background-images",
    "allow-add-background-image",
    "allow-read-background-image",
    "allow-delete-background-image",
    "allow-ai-run",
    "allow-ai-cancel",
    "allow-ai-detect",
    "allow-set-ai-provider",
    "allow-set-ai-allow-images",
    "allow-set-ai-effort",
    "allow-open-ai-install-guide",
    "allow-open-login-terminal"
  ]
}
