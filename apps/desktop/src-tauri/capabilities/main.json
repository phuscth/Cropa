{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window (editor, history and settings views, with its own title bar): moves, minimizes, maximizes and closes itself, starts a region capture from its empty editor, opens an image the user drops, pastes or picks in the editor, clears the editor's image when the user starts over, listens to app events, reads the app version and the shortcut status, reads and changes user settings, lists, copies, opens and deletes past captures, reads and saves the AI chat of a capture, manages the user's saved background presets and background images and exports a preset to a file, saves, copies and reveals exported images, lets the user drag the image into other apps, remembers the settings page shown, and detects, sets up, runs and cancels AI turns.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "allow-get-main-view",
    "allow-get-settings-section",
    "allow-set-settings-section",
    "allow-request-capture",
    "allow-get-settings",
    "allow-get-shortcut-status",
    "allow-set-capture-shortcut",
    "allow-open-print-screen-setting",
    "allow-set-theme",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-set-save-history",
    "allow-set-exclude-from-clipboard-history",
    "allow-choose-save-folder",
    "allow-reset-save-folder",
    "allow-open-sponsors-page",
    "allow-list-history",
    "allow-get-history-thumbnail",
    "allow-copy-history-image",
    "allow-delete-history-image",
    "allow-delete-history-images",
    "allow-delete-all-history",
    "allow-open-history-in-editor",
    "allow-get-chat",
    "allow-save-chat",
    "allow-get-editor-image",
    "allow-import-editor-image",
    "allow-clear-editor-image",
    "allow-quick-save",
    "allow-choose-save-as-path",
    "allow-write-save-as",
    "allow-copy-rendered-image",
    "allow-start-drag",
    "allow-reveal-saved-file",
    "allow-list-user-presets",
    "allow-save-user-preset",
    "allow-delete-user-preset",
    "allow-save-preset-file",
    "allow-list-background-images",
    "allow-add-background-image",
    "allow-read-background-image",
    "allow-delete-background-image",
    "allow-ai-run",
    "allow-ai-cancel",
    "allow-ai-detect",
    "allow-ai-list-models",
    "allow-set-ai-model",
    "allow-set-ai-favorite-model",
    "allow-set-ai-allow-images",
    "allow-set-ai-effort",
    "allow-open-ai-install-guide",
    "allow-open-login-terminal"
  ]
