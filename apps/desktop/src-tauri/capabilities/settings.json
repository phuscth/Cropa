{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window: reads and changes user settings.",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-settings",
    "allow-get-shortcut-status",
    "allow-set-capture-shortcut",
    "allow-open-print-screen-setting",
    "allow-set-theme",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-set-save-history",
    "allow-set-exclude-from-clipboard-history"
  ]
}
