{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window: reads and changes user settings and checks which AI providers are available, sets up and tests AI.",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-settings",
    "allow-open-window",
    "allow-get-shortcut-status",
    "allow-set-capture-shortcut",
    "allow-open-print-screen-setting",
    "allow-set-theme",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-set-save-history",
    "allow-set-exclude-from-clipboard-history",
    "allow-choose-save-folder",
    "allow-reset-save-folder",
    "allow-open-sponsors-page",
    "allow-ai-detect",
    "allow-ai-run",
    "allow-ai-cancel",
    "allow-set-ai-provider",
    "allow-set-ai-allow-images",
    "allow-open-ai-install-guide",
    "allow-open-login-terminal",
    "core:app:allow-version"
  ]
}
