{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Editor window: listens to app events and reads the shortcut status.",
  "windows": ["editor"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-shortcut-status",
    "allow-get-editor-image",
    "allow-quick-save",
    "allow-choose-save-as-path",
    "allow-write-save-as",
    "allow-copy-rendered-image",
    "allow-reveal-saved-file"
  ]
}
