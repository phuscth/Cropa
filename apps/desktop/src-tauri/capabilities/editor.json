{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Editor window: listens to app events, reads the shortcut status and manages the user's saved background presets.",
  "windows": ["editor"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-shortcut-status",
    "allow-get-editor-image",
    "allow-list-user-presets",
    "allow-save-user-preset",
    "allow-delete-user-preset"
  ]
}
