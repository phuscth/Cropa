{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "history",
  "description": "History window: lists, copies, opens and deletes past captures.",
  "windows": ["history"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-history",
    "allow-get-history-thumbnail",
    "allow-copy-history-image",
    "allow-delete-history-image",
    "allow-delete-all-history",
    "allow-open-history-in-editor",
    "allow-get-settings"
  ]
}
